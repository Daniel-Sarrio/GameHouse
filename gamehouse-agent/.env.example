PORT=3001
# Crea tu key en https://openrouter.ai/keys y guárdala solo en .env (nunca en el repositorio).
OPENROUTER_API_KEY=
# Modelo de OpenRouter, por ejemplo: openai/gpt-4o-mini
OPENROUTER_MODEL=
FRONTEND_URL=http://localhost:4200
# Token compartido con el backend para POST /api/agent/insights (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_INTERNAL_TOKEN=
