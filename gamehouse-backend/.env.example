PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=GameHome
DB_USER=postgres
DB_PASSWORD=tu_contrasena

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del access token y caducidad absoluta de la sesión (refresh token).
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:4200
# Proxies de confianza para X-Forwarded-For: el API Gateway corre en la misma máquina.
TRUST_PROXY=loopback
# Análisis de opiniones con el agente IA, a través de la gateway. El token debe coincidir con el del agente.
AGENT_API_URL=http://localhost:4000/api/agent
AGENT_INTERNAL_TOKEN=
