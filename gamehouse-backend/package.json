{
  "name": "gamehouse-backend",
  "version": "1.0.0",
  "description": "Base de la API REST de GameHouse",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node migrate.js",
    "migrate:profiles": "node migrate-profiles.js",
    "migrate:auth": "node migrate-auth.js",
    "migrate:soft-delete": "node migrate-soft-delete.js",
    "migrate:users": "node migrate-users.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed": "node migrate.js && node seed.js",
    "dev": "nodemon src/server.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.13.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
