{
  "name": "gamehouse-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway de GameHouse: punto de entrada único (puerto 4000) que enruta al backend y al agente",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "http-proxy-middleware": "^3.0.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
